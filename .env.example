# Copy this file to .env and fill in the values. Never commit .env.
# Values already set in the environment (e.g. on Render) win over this file.

# Companies House API key (company details and directors)
CH_API_KEY=

# Serper API key (finds each company's website domain)
SERPER_API_KEY=

# Hunter API key (finds director emails). Empty = no email lookups.
HUNTER_API_KEY=

# FullEnrich API key (finds mobile numbers). Empty = no phone lookups.
FULLENRICH_API_KEY=

# Supabase project URL and service-role key (saves finished jobs).
# Not needed for a local run.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JOBS_BUCKET=pipeline-jobs

# HubSpot. Keep HUBSPOT_AUTO_PUSH=false until the data is stable.
HUBSPOT_AUTO_PUSH=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PROJECT_OBJECT=0-970
